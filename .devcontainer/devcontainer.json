{
    "name": "dev_template",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "BASE_IMAGE": "ihedgehog/idf-dev:release-5.4-46909c504864d83a2bb518ac948b5e4c658928e1"
        }
    },
    "remoteUser": "ubuntu",
    "runArgs": [
        "--privileged",
        "--name=dev_template"
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "idf.espIdfPath": "/opt/esp/idf",
                "idf.toolsPath": "/opt/esp",
                "idf.gitPath": "/usr/bin/git",
                "idf.svdFilePath": "/opt/esp_debug/svd/${command:espIdf.getIDFTarget}.svd",
                "idf.customTask": "cd ${workspaceFolder}/build && esptool.py --chip ${command:espIdf.getIDFTarget} merge_bin -o ${workspaceFolder}/${command:espIdf.getIDFTarget}_merged_firmware.bin @flash_args",
                "C_Cpp.clang_format_style": "file:/opt/c_lang_format/.clang-format",
                "C_Cpp.default.includePath": [
                    "${config:idf.espIdfPath}/components/**",
                    "${workspaceFolder}/**"
                ],
                "C_Cpp.default.browse.path": [
                    "${config:idf.espIdfPath}/components",
                    "${workspaceFolder}"
                ],
                "C_Cpp.default.browse.limitSymbolsToIncludedHeaders": true,
                "C_Cpp.default.compileCommands": "${config:idf.buildPath}/compile_commands.json"
            },
            "extensions": [
                "ms-vscode.cpptools",
                "espressif.esp-idf-extension",
                "eamodio.gitlens"
            ]
        }
    }
}