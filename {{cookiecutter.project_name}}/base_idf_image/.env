# Select ESP-IDF version branch or tag.
IDF_CLONE_BRANCH_OR_TAG=release/v5.4

# Select specific branch commit. (!) Commit is stronger than tag above, may overpower the branch (!).
IDF_CHECKOUT_REF=46909c504864d83a2bb518ac948b5e4c658928e1

# Use IDF_CLONE_SHALLOW=1 to perform IDF shallow clone (i.e. --depth=1 --shallow-submodules).
# This reduce the size of the resulting image (use with caution).
IDF_CLONE_SHALLOW=1

# Set IDF_CLONE_SHALLOW_DEPTH=X to define the depth if IDF_CLONE_SHALLOW is used (i.e. --depth=X)
# Is the number of commits from HEAD to your IDF_CHECKOUT_REF inside the branch (has to include your commit).
IDF_CLONE_SHALLOW_DEPTH=10

# Select included flash tools for targets (reduce image size and complex dependencies). 
# Specify a space-separated list of targets no spaces (esp32,esp32s3) or use all for full set.
IDF_INSTALL_TARGETS=esp32,esp32s3,esp32c3,esp32c6

# Specify your resulting base image name. This should be referenced with tags included.
# Hint: use dockerhub style name (username/image_name:tag) for optional easy push to dockerhub afterwards (manually). 
BASE_IMAGE_NAME=ihedgehog/idf-dev:release-5.4-46909c504864d83a2bb518ac948b5e4c658928e1